# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=

# Admin Telegram User ID (for whitelist management)
AUTHORIZED_USER=
# Agent Configuration
OPENAI_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
DEFAULT_MODEL=

# NanoGateway (optional local LLM proxy). When enabled, the start command
# launches `nanogateway serve` and routes the bot through it.
USE_NANOGATEWAY=false
# Port the local NanoGateway listens on (the bot points here)
NANOGATEWAY_PORT=9000
# Upstream the gateway forwards to (defaults to OPENAI_BASE_URL above)
NANOGATEWAY_URL=

# Session Configuration
DEFAULT_IDLE_TIMEOUT_SECONDS=300

# Database Configuration
DATABASE_PATH=./telebasebot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console